\name{read_spatialess_bundle}
\alias{read_spatialess_bundle}
\title{Read a SpatialESS H5AD bridge bundle}
\usage{read_spatialess_bundle(path)}
\arguments{
\item{path}{Bundle directory produced by \code{export_spatialess_h5ad_bundle()}.}
}
\description{
Reads and validates the sparse Matrix Market expression, cell order, gene
order, spatial coordinates and group labels generated by the Python bridge.
}
\value{A list containing expression, coordinates, group, metadata and manifest.}
